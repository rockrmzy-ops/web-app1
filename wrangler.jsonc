{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app1",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "c93ded79-e18f-4664-8b90-c6dcecce6422","database_name": "web-app1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "748c7dd2194643e98931c15549fc4c8c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
